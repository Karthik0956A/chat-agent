# Gemini API — https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Tavily Search API — https://tavily.com/
# Evaluators can paste their Tavily API key here
TAVILY_API_KEY=your_tavily_api_key_here

# Optional: Legacy Brave Search API fallback (if using Brave instead of Tavily)
# BRAVE_API_KEY=your_brave_search_api_key_here

# JWT secret — change to any random string in production
JWT_SECRET=change_me_to_a_random_string

# Models
PLANNER_MODEL=gemini-2.0-flash
SYNTHESIZER_MODEL=gemini-2.0-flash
EMBEDDING_MODEL=text-embedding-004

# Server
PORT=3000
DB_PATH=./data/agent.db
